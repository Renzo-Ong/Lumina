# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/elibrary
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/elibrary"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="replace-with-a-long-random-string"

# Access token lifetime (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN="7d"

# Port the Express server listens on
PORT=4000

# OpenAlex requests are free but OpenAlex asks for a contact email in the
# "mailto" param so they can reach you if something goes wrong on their end.
# Used later by the OpenAlex integration — safe to fill in now.
OPENALEX_MAILTO="yourgroup@example.edu"
