// ─────────────────────────────────────────────────────────────────────────────
// Academic E-Library & Research Portal — Database Schema
// ─────────────────────────────────────────────────────────────────────────────
// Design notes:
// - Two roles: STUDENT and LIBRARIAN (LIBRARIAN = admin in the assignment brief).
// - `Work` is the local cache of literature. Rows can come from OpenAlex
//   (source = OPENALEX) or be added directly by a librarian (source = MANUAL).
//   Imported works start as PENDING and must be APPROVED by a librarian before
//   students can see them in search results — this is what satisfies the
//   "approve imported sources" requirement in the rubric.
// - Bookmarking a work for a student is modeled as `SavedWork`, which is the
//   anchor for personal Notes, Tags, and Collection membership.
// - `ActivityLog` powers the "Recent Activity" feed on the profile page and
//   also doubles as lightweight evidence of usage for your progress reports.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  LIBRARIAN
}

enum WorkSource {
  OPENALEX
  MANUAL
}

enum WorkStatus {
  PENDING   // imported from OpenAlex, awaiting librarian approval
  APPROVED  // visible to students in search
  REJECTED  // hidden, kept for audit trail
}

enum ActivityAction {
  SAVED_WORK
  UNSAVED_WORK
  CREATED_COLLECTION
  ADDED_TO_COLLECTION
  GENERATED_CITATION
  COMPARED_WORKS
  IMPORTED_WORK
  APPROVED_WORK
  REJECTED_WORK
  EDITED_WORK
  DELETED_WORK
}

// ─── Core models ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  institution  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  savedWorks    SavedWork[]
  collections   Collection[]
  tags          Tag[]
  activityLogs  ActivityLog[]
  worksAdded    Work[]        @relation("WorkAddedBy")
  worksReviewed Work[]        @relation("WorkReviewedBy")

  @@map("users")
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  works Work[]

  @@map("categories")
}

model Work {
  id             String     @id @default(cuid())
  openAlexId     String?    @unique // e.g. "W2741809807"; null for manually added works
  title          String
  abstractText   String?
  year           Int?
  journal        String?
  doi            String?
  authors        String[]   // denormalized display names, e.g. ["Reyes, M. A.", "Santos, J. L."]
  method         String?    // e.g. Survey, Case Study, Systematic Review
  country        String?
  citationCount  Int        @default(0)
  openAccess     Boolean    @default(false)
  source         WorkSource @default(OPENALEX)
  status         WorkStatus @default(APPROVED)
  rawResponse    Json?      // full OpenAlex API payload, kept for auditing/reprocessing

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  addedById String?
  addedBy   User?   @relation("WorkAddedBy", fields: [addedById], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("WorkReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedWorks     SavedWork[]
  activityLogs   ActivityLog[]

  @@index([title])
  @@index([year])
  @@index([status])
  @@map("works")
}

// A student's personal bookmark of a Work — the anchor for notes, tags, and
// collection membership. One row per (user, work) pair.
model SavedWork {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId   String
  work     Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  savedAt  DateTime @default(now())

  notes           Note[]
  tags            SavedWorkTag[]
  collectionItems CollectionItem[]

  @@unique([userId, workId])
  @@map("saved_works")
}

model Note {
  id          String    @id @default(cuid())
  savedWorkId String
  savedWork   SavedWork @relation(fields: [savedWorkId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("notes")
}

// Tags are personal to a student (not shared across users).
model Tag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  savedWorks SavedWorkTag[]

  @@unique([userId, name])
  @@map("tags")
}

model SavedWorkTag {
  savedWorkId String
  savedWork   SavedWork @relation(fields: [savedWorkId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([savedWorkId, tagId])
  @@map("saved_work_tags")
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  colorHex  String   @default("#7c5cbf")
  createdAt DateTime @default(now())

  items CollectionItem[]

  @@unique([userId, name])
  @@map("collections")
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  savedWorkId  String
  savedWork    SavedWork  @relation(fields: [savedWorkId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@unique([collectionId, savedWorkId])
  @@map("collection_items")
}

// Powers the "Recent Activity" feed and gives you an audit trail you can
// screenshot as evidence of development/usage in your weekly progress reports.
model ActivityLog {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    ActivityAction
  workId    String?
  work      Work?          @relation(fields: [workId], references: [id], onDelete: SetNull)
  detail    String?
  createdAt DateTime       @default(now())

  @@index([userId, createdAt])
  @@map("activity_logs")
}
